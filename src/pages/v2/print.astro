---
// Printable paper invitation for the movie edition: a 4x6 portrait card (102x152 mm), front and back,
// laid out on 106x156 mm sheets that include 2 mm of bleed on every side.
// The trim (cut) line is part of the output, on screen and in print; text keeps 4 mm inside it.
// Open /v2/print/ and print to PDF with no margins and backgrounds on.
import { getImage } from 'astro:assets';
import QRCode from 'qrcode';
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-serif-display/latin-400-italic.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import { wedding } from '../../data/wedding';
import { movie } from '../../data/movie';
import { loadGallery } from '../../lib/gallery';
import { day, month, shortDate, weekday, eventDate } from '../../lib/event';

const root = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const mobileUrl = new URL(root + 'v2/', Astro.site).href;
const qr = await QRCode.toString(mobileUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1f2619', light: '#0000' } });
// The main photo (the mobile cover's, movie.cover) at its full size; it fills the whole sheet, bleed included.
const gallery = loadGallery(wedding.gallery, { groom: wedding.groom.name, bride: wedding.bride.name, release: process.env.RELEASE_BUILD === '1' });
const mainPhoto = (gallery.find((photo) => photo.id === movie.cover.photo) ?? gallery[0]).image;
const poster = await getImage({ src: mainPhoto, width: Number((await getImage({ src: mainPhoto })).attributes.width), format: 'jpg', quality: 95 });
const timeEn = new Intl.DateTimeFormat('en-US', { timeZone: wedding.timeZone, hour: 'numeric', minute: '2-digit' }).format(eventDate);
const { paper } = movie;
const parents = [
  { father: wedding.groom.father, mother: wedding.groom.mother, child: paper.relation.groom, name: wedding.groom.name },
  { father: wedding.bride.father, mother: wedding.bride.mother, child: paper.relation.bride, name: wedding.bride.name },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{movie.titleText} · 지류 청첩장 4x6 (인쇄용)</title>
    <style>
      @page { size: 106mm 156mm; margin: 0; }
      :root { --ink: #0c0c0d; --cream: #efe8da; --cream-2: #d6cebf; --muted: #9c9587; --gold: #e2c07c; --sage: #c3c9a8; --sage-ink: #1f2619;
        --serif: 'DM Serif Display', Georgia, serif; --korean: 'Pretendard Variable', 'Apple SD Gothic Neo', sans-serif;
        --bleed: 2mm; --safe: 6mm;
        /* Back-page type scale: every size on the back is one of these four. */
        --fs-lead: 8pt; --fs-body: 6.5pt; --fs-detail: 5.8pt; --fs-label: 4.8pt; }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: #555; -webkit-print-color-adjust: exact; print-color-adjust: exact; font-variant-numeric: lining-nums; }
      body { font-family: var(--korean); font-weight: 300; color: var(--cream); }
      p, h1, h2, dl, dd { margin: 0; font-weight: 400; }
      .sheet { position: relative; width: 106mm; height: 156mm; margin: 10mm auto; overflow: hidden; background: var(--ink); break-after: page; }
      .sheet:last-child { break-after: auto; }
      @media print { html, body { background: none; } .sheet { margin: 0; } }

      /* Guide: the trim (cut) line at the bleed. Text still keeps to the 4 mm safe area inside it (--safe). */
      .guides { position: absolute; inset: 0; z-index: 10; pointer-events: none; }
      .guides::before { content: ''; position: absolute; inset: var(--bleed); border: .25mm solid #3ec1e6; }

      /* Front */
      .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
      /* No text-shadow on the front: Chrome writes blurred shadows into the PDF as soft-masked tiles, and macOS
         Preview draws those as dark boxes behind the text. The shade alone keeps the white type legible. */
      .front-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 14 10 / .5) 0%, rgb(10 14 10 / .12) 24%, rgb(10 14 10 / 0) 34%, rgb(10 14 10 / 0) 64%, rgb(10 14 10 / .58) 84%, rgb(10 14 10 / .8) 100%); }
      /* The film's title, set the same way on the mobile cover: the main line in italic, the second in capitals. */
      .front-title { position: absolute; top: 11mm; left: var(--safe); right: var(--safe); display: grid; justify-items: center; font-family: var(--serif); color: var(--cream); line-height: .92; }
      .front-title .t-main { font-style: italic; font-size: 32pt; }
      .front-title .t-sub { margin: 1.5mm -.06em 0 0; font-size: 17pt; letter-spacing: .06em; text-transform: uppercase; }
      .front-foot { position: absolute; left: var(--safe); right: var(--safe); bottom: 11mm; display: grid; justify-items: center; gap: .8mm; font-family: var(--serif); font-size: 7.2pt; letter-spacing: .04em; color: var(--cream-2); text-align: center; }
      /* Same palette as the back: cream type, a gold rule. */
      .front-foot .rule { width: 3mm; height: .25mm; margin: .8mm 0; background: var(--gold); }

      /* Back */
      .back { display: flex; flex-direction: column; justify-content: center; padding: calc(var(--safe) + 2mm) calc(var(--safe) + 1mm); text-align: center; }
      .eyebrow { font-family: var(--serif); font-size: var(--fs-body); letter-spacing: .34em; margin-right: -.34em; color: var(--gold); }
      .verse { display: grid; margin-top: 2.6mm; font-size: var(--fs-lead); line-height: 1.55; letter-spacing: -.02em; }
      .verse span:first-child::before, .verse span:last-child::after { font-family: var(--serif); font-size: 1.15em; color: var(--gold); }
      .verse span:first-child::before { content: '\201C'; margin-right: .8mm; }
      .verse span:last-child::after { content: '\201D'; margin-left: .8mm; }
      .cite { margin-top: 1mm; font-size: var(--fs-detail); font-weight: 400; color: var(--muted); }
      .greeting { margin-top: 3mm; font-size: var(--fs-body); line-height: 1.8; color: var(--cream-2); }
      .families { display: grid; gap: .2mm; margin-top: 2.6mm; font-size: var(--fs-body); line-height: 1.75; }
      .families .rel { font-size: var(--fs-detail); color: var(--muted); margin: 0 .8mm 0 .3mm; }
      .families strong { font-weight: 500; letter-spacing: .06em; }

      /* The location and the QR code share one movie ticket, the details on its body and the code on the stub,
         so the code needs no row of its own. The ticket is as wide as its longest line needs. */
      .ticket { position: relative; display: flex; flex-shrink: 0; width: max-content; max-width: 100%; margin: 6mm auto 0; color: var(--sage-ink); text-align: left; transform: rotate(-1.5deg); }
      .ticket-main, .ticket-stub { position: relative; background: var(--sage); }
      .ticket-main { flex: 1; padding: 3mm 6mm 3.2mm 3.6mm; border-radius: 1.5mm 0 0 1.5mm; }
      .ticket-stub { display: grid; justify-items: center; align-content: center; gap: 1.8mm; width: 22mm; padding: 3mm 1.5mm; border-left: .35mm dashed rgb(31 38 25 / .45); border-radius: 0 1.5mm 1.5mm 0; }
      /* Half-circle notches at both ends of the perforation, in the page colour. */
      .ticket-stub::before, .ticket-stub::after { content: ''; position: absolute; left: -1.9mm; width: 3.4mm; height: 3.4mm; border-radius: 50%; background: var(--ink); }
      .ticket-stub::before { top: -1.7mm; }
      .ticket-stub::after { bottom: -1.7mm; }
      .ticket-top { display: flex; justify-content: space-between; padding-bottom: 1.2mm; border-bottom: .15mm solid rgb(31 38 25 / .3); font-family: var(--serif); font-size: var(--fs-detail); letter-spacing: .18em; }
      /* One grid for all rows, so the labels share a column; each label sits at the middle of its lines. */
      .ticket dl { display: grid; grid-template-columns: max-content 1fr; gap: 1.3mm 1.8mm; align-items: center; margin-top: 2mm; }
      .loc-row { display: contents; }
      .loc-row dt { font-size: var(--fs-detail); font-weight: 600; line-height: 1.55; text-align: right; }
      .loc-row dd { display: grid; padding-left: 1.8mm; border-left: .15mm solid rgb(31 38 25 / .3); font-size: var(--fs-detail); line-height: 1.55; word-break: keep-all; }
      .qr { width: 16mm; height: 16mm; }
      .qr :global(svg) { display: block; width: 100%; height: 100%; }
      .stub-cta { font-size: var(--fs-detail); font-weight: 600; line-height: 1.3; text-align: center; }
      .stub-cta .label { display: block; font-family: var(--serif); font-size: var(--fs-label); font-weight: 400; letter-spacing: .14em; }
      .play { display: inline-block; width: 0; height: 0; margin-left: .6mm; border-left: 1.2mm solid var(--sage-ink); border-top: .75mm solid transparent; border-bottom: .75mm solid transparent; }
    </style>
  </head>
  <body>
    <section class="sheet front">
      <img class="photo" src={poster.src} alt={wedding.hero.alt} />
      <div class="front-shade"></div>
      <h1 class="front-title" lang="en" aria-label={movie.titleText}>
        <span class="t-main">{movie.title.main}</span>
        <span class="t-sub">{movie.title.sub}</span>
      </h1>
      <div class="front-foot" lang="en">
        <p>{shortDate} {weekday}&nbsp;&nbsp;{timeEn.replace(' ', '')}</p>
        <p>{paper.front.venue}</p>
        <span class="rule" aria-hidden="true"></span>
        <p>{paper.front.names}</p>
      </div>
      <div class="guides" aria-hidden="true"></div>
    </section>

    <section class="sheet back">
      <p class="eyebrow" lang="en">{paper.heading}</p>
      <p class="verse">{paper.verse.lines.map((line) => <span>{line}</span>)}</p>
      <p class="cite">{paper.verse.source}</p>
      <div class="greeting">{paper.greeting.map((line) => <p>{line}</p>)}</div>
      <div class="families">
        {parents.map((p) => <p>{p.father} · {p.mother}<span class="rel">의 {p.child}</span><strong>{p.name}</strong></p>)}
      </div>

      <div class="ticket">
        <div class="ticket-main">
          <p class="ticket-top" lang="en"><span>LOCATION</span><span>NO. {String(month).padStart(2, '0')}{String(day).padStart(2, '0')}</span></p>
          <dl>
            {paper.location.map((row) => (
              <div class="loc-row"><dt>{row.label}</dt><dd>{row.lines.map((line) => <span>{line}</span>)}</dd></div>
            ))}
          </dl>
        </div>
        <div class="ticket-stub">
          <div class="qr" role="img" aria-label="모바일 청첩장으로 가는 QR 코드" set:html={qr}></div>
          <p class="stub-cta"><span class="label" lang="en">SCAN TO WATCH</span>영화 보러 가기<span class="play" aria-hidden="true"></span></p>
        </div>
      </div>
      <div class="guides" aria-hidden="true"></div>
    </section>
  </body>
</html>
