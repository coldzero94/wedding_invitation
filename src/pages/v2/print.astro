---
// Printable paper invitation for the movie edition: a 4x6 portrait card (102x152 mm), front and back,
// laid out on 106x156 mm sheets that include 2 mm of bleed on every side.
// The trim (cut) line is part of the output, on screen and in print; text keeps 4 mm inside it.
// Open /v2/print/ and print to PDF with no margins and backgrounds on.
import { getImage } from 'astro:assets';
import QRCode from 'qrcode';
import '@fontsource/rozha-one/latin-400.css';
import '@fontsource/fraunces/latin-700-italic.css';
import '@fontsource/noto-serif-display/latin-600.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import Doodles from '../../components/Doodles.astro';
import { wedding } from '../../data/wedding';
import { movie } from '../../data/movie';
import { loadGallery } from '../../lib/gallery';
import { shortDate, weekday, eventDate } from '../../lib/event';

const root = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const mobileUrl = new URL(root + 'v2/', Astro.site).href;
const qr = await QRCode.toString(mobileUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#0c0c0d', light: '#0000' } });
// The main photo (the mobile cover's, movie.cover) at its full size; it fills the whole sheet, bleed included.
const gallery = loadGallery(wedding.gallery, { groom: wedding.groom.name, bride: wedding.bride.name, release: process.env.RELEASE_BUILD === '1' });
const mainPhoto = (gallery.find((photo) => photo.id === movie.cover.photo) ?? gallery[0]).image;
const poster = await getImage({ src: mainPhoto, width: Number((await getImage({ src: mainPhoto })).attributes.width), format: 'jpg', quality: 95 });
const timeEn = new Intl.DateTimeFormat('en-US', { timeZone: wedding.timeZone, hour: 'numeric', minute: '2-digit' }).format(eventDate);
const { paper } = movie;
const parents = [
  { father: wedding.groom.father, mother: wedding.groom.mother, child: paper.relation.groom, name: wedding.groom.name },
  { father: wedding.bride.father, mother: wedding.bride.mother, child: paper.relation.bride, name: wedding.bride.name },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>지류 청첩장 4x6 (인쇄용)</title>
    <style>
      @page { size: 106mm 156mm; margin: 0; }
      :root { --ink: #0c0c0d; --cream: #efe8da; --cream-2: #d6cebf; --gold: #e2c07c;
        --serif: 'Rozha One', Georgia, serif; --title: 'Fraunces', Georgia, serif; --billing: 'Noto Serif Display', Georgia, serif; --page: #fbeac4; --korean: 'Pretendard Variable', 'Apple SD Gothic Neo', sans-serif;
        --bleed: 2mm; --safe: 6mm;
        /* The back: dark type on white, with the gold deepened so it reads on paper. */
        --text: #23201b; --text-2: #4a443b; --muted: #8b8376; --accent: #977434;
        /* Back-page type scale. Nothing is under 8 pt, the smallest size that still reads easily once printed. */
        --fs-head: 11pt; --fs-lead: 9pt; --fs-body: 8.5pt; --fs-small: 8pt; }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: #555; -webkit-print-color-adjust: exact; print-color-adjust: exact; font-variant-numeric: lining-nums; }
      body { font-family: var(--korean); font-weight: 400; }
      p, h1, h2, dl, dd { margin: 0; font-weight: 400; }
      .sheet { position: relative; width: 106mm; height: 156mm; margin: 10mm auto; overflow: hidden; background: var(--ink); break-after: page; }
      .sheet:last-child { break-after: auto; }
      @media print { html, body { background: none; } .sheet { margin: 0; } }

      /* Guide: the trim (cut) line at the bleed. Text still keeps to the 4 mm safe area inside it (--safe). */
      .guides { position: absolute; inset: 0; z-index: 10; pointer-events: none; }
      .guides::before { content: ''; position: absolute; inset: var(--bleed); border: .25mm solid #3ec1e6; }

      /* Front */
      .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
      /* No text-shadow on the front: Chrome writes blurred shadows into the PDF as soft-masked tiles, and macOS
         Preview draws those as dark boxes behind the text. The shade alone keeps the type legible, as measured off the
         couple's mock-up: the photo untouched down to the dress, then darker to black at the trim. */
      .front-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 12 10 / 0) 0%, rgb(10 12 10 / 0) 79%, rgb(10 12 10 / .17) 84%, rgb(10 12 10 / .44) 89%, rgb(10 12 10 / .69) 94%, rgb(10 12 10 / 1) 98.7%); }
      /* The couple's doodles, drawn on the photo in its own pixels (Doodles.astro); the photo is cropped from its centre. */
      :global(.front-doodles) { position: absolute; inset: 0; width: 100%; height: 100%; }
      /* Title and billing as on the couple's mock-up: the title's capitals 6.6 mm under the trim, one word a line;
         the billing in Noto Serif Display SemiBold, its last line 11.5 mm above the trim (8 pt, a touch larger than
         the mock-up's 7 pt, for the 8 pt minimum). */
      .front-title { position: absolute; top: 6.4mm; left: -1.2mm; right: 0; display: grid; justify-items: center; font-family: var(--title); font-style: italic; font-weight: 700; font-size: 11.4mm; line-height: 12.65mm; color: var(--page); }
      .front-foot { position: absolute; left: var(--safe); right: var(--safe); bottom: 13mm; display: grid; justify-items: center; gap: .3mm; font-family: var(--billing); font-weight: 600; font-size: 8pt; letter-spacing: .02em; color: var(--page); text-align: center; }
      .front-foot .rule { width: 2.2mm; height: .2mm; margin: 1.85mm 0; background: var(--page); }

      /* Back: white, split into two halves, the invitation above and the location below. */
      .back { display: grid; grid-template-rows: 1fr 1fr; padding: 12.67mm 7mm 14.33mm; background: #fff; color: var(--text); }
      .section-head { font-family: var(--serif); font-size: var(--fs-head); letter-spacing: .22em; margin-right: -.22em; color: var(--accent); text-align: center; }
      .invite { text-align: center; }
      .verse { display: grid; margin-top: 4mm; font-size: var(--fs-lead); line-height: 1.55; letter-spacing: -.02em; }
      .verse span:first-child::before, .verse span:last-child::after { font-family: var(--serif); font-size: 1.15em; color: var(--accent); }
      .verse span:first-child::before { content: '\201C'; margin-right: .8mm; }
      .verse span:last-child::after { content: '\201D'; margin-left: .8mm; }
      .cite { margin-top: 1mm; font-size: var(--fs-small); color: var(--muted); }
      .greeting { margin-top: 3.6mm; font-size: var(--fs-body); line-height: 1.7; color: var(--text-2); }
      .families { display: grid; margin-top: 3.2mm; font-size: var(--fs-lead); line-height: 1.65; }
      .families .rel { font-size: var(--fs-small); color: var(--muted); margin: 0 1mm 0 .4mm; }
      .families strong { font-weight: 600; letter-spacing: .06em; }

      /* Location: the list and the QR code below it share one left edge, and that block is centred. */
      .location { display: flex; flex-direction: column; }
      .location-body { display: flex; flex: 1; flex-direction: column; width: max-content; max-width: 100%; margin: 4mm auto 0; }
      /* One grid for all rows, so the labels share a column; each label sits at the middle of its lines. */
      .location dl { display: grid; grid-template-columns: max-content max-content; gap: 2.4mm 4mm; align-items: center; }
      .loc-row { display: contents; }
      .loc-row dt { font-size: var(--fs-body); font-weight: 600; line-height: 1.65; }
      .loc-row dd { display: grid; font-size: var(--fs-small); line-height: 1.65; color: var(--text-2); word-break: keep-all; }
      /* A small colophon connects the paper's title to its mobile continuation. The open white space
         around the QR is its quiet zone; keep at least 2 mm clear on every side of the 13 mm code. */
      .mobile-invitation { display: grid; grid-template-columns: 1fr 13mm; align-items: end; gap: 5mm; width: 70mm; margin-top: auto; padding-top: 3mm; border-top: .2mm solid var(--accent); color: inherit; text-decoration: none; }
      .mobile-invitation:focus-visible { outline: 2px solid var(--accent); outline-offset: 2mm; }
      .mobile-title { margin-bottom: 1.5mm; font-family: var(--title); font-style: italic; font-weight: 700; font-size: 12pt; line-height: 1.1; color: var(--accent); }
      .mobile-label { font-size: 8.5pt; font-weight: 600; line-height: 1.5; }
      .mobile-description { margin-top: .5mm; font-size: var(--fs-small); line-height: 1.5; color: var(--text-2); }
      .qr { width: 13mm; height: 13mm; }
      .qr :global(svg) { display: block; width: 100%; height: 100%; }
    </style>
  </head>
  <body>
    <section class="sheet front">
      <img class="photo" src={poster.src} alt={wedding.hero.alt} />
      <div class="front-shade"></div>
      <Doodles class="front-doodles" />
      <h1 class="front-title" lang="en">{movie.title.map((word, i) => <>{i > 0 && ' '}<span>{word}</span></>)}</h1>
      <div class="front-foot" lang="en">
        <p>{shortDate} {weekday} {timeEn.replace(' ', '')}</p>
        <p>{paper.front.venue}</p>
        <span class="rule" aria-hidden="true"></span>
        <p>{paper.front.names}</p>
      </div>
      <div class="guides" aria-hidden="true"></div>
    </section>

    <section class="sheet back">
      <div class="invite">
        <p class="section-head" lang="en">{paper.heading}</p>
        <p class="verse">{paper.verse.lines.map((line) => <span>{line}</span>)}</p>
        <p class="cite">{paper.verse.source}</p>
        <div class="greeting">{paper.greeting.map((line) => <p>{line}</p>)}</div>
        <div class="families">
          {parents.map((p) => <p>{p.father} · {p.mother}<span class="rel">의 {p.child}</span><strong>{p.name}</strong></p>)}
        </div>
      </div>

      <div class="location">
        <p class="section-head" lang="en">LOCATION</p>
        <div class="location-body">
          <dl>
            {paper.location.map((row) => (
              <div class="loc-row"><dt>{row.label}</dt><dd>{row.lines.map((line) => <span>{line}</span>)}</dd></div>
            ))}
          </dl>
          <a class="mobile-invitation" href={mobileUrl} aria-label="모바일 청첩장 보기">
            <div class="mobile-copy">
              <p class="mobile-title" lang="en">{movie.title.join(' ')}</p>
              <p class="mobile-label">{paper.mobile.heading}</p>
              <p class="mobile-description">{paper.mobile.description}</p>
            </div>
            <div class="qr" role="img" aria-label="모바일 청첩장으로 가는 QR 코드" set:html={qr}></div>
          </a>
        </div>
      </div>
      <div class="guides" aria-hidden="true"></div>
    </section>
  </body>
</html>
