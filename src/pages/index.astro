---
import { Image, getImage } from 'astro:assets';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/noto-serif-kr/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { wedding } from '../data/wedding';
import { createPhotoArchive } from '../lib/photo-archive';
import { year, month, day, longDate, time, shortDate, weekday, firstWeekday, daysInMonth } from '../lib/event';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const title = (wedding.isDemo ? '[샘플] ' : '') + wedding.groom.name + ' & ' + wedding.bride.name + ' — 결혼합니다';
const canonical = new URL(base, Astro.site);
const og = await getImage({ src: wedding.hero.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const { albums, previews } = createPhotoArchive(wedding.photos, wedding.albums, wedding.previewPhotoIds);
const featuredAlbum = albums[0];
const feedPhoto = wedding.photos[0];
const venueLabel = [wedding.venue.name, wedding.venue.detail].filter(Boolean).join(' · ');
const kakaoJsKey = (process.env.KAKAO_JS_KEY || '').trim();
const kakaoMapUrl = wedding.venue.mapLinks.find((map) => map.label.includes('카카오'))?.url || wedding.venue.mapLinks[0]?.url || canonical.href;
const contacts = [{ ...wedding.groom, role: '신랑' }, { ...wedding.bride, role: '신부' }].filter(person => wedding.isDemo || person.phone.trim());
const showContact = contacts.length > 0;
const showAccounts = wedding.isDemo || wedding.accounts.length > 0;
const gallery = await Promise.all(wedding.photos.map(async (photo) => ({
  id: photo.id,
  src: (await getImage({ src: photo.image, width: 1600, format: 'webp' })).src,
  alt: photo.alt, title: photo.title, story: photo.subtitle,
})));
const emptyCells = Array.from({ length: firstWeekday });
const dates = Array.from({ length: daysInMonth }, (_, i) => i + 1);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#181b18" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={longDate + ' ' + time + ' · ' + wedding.venue.name + '. 저희의 새로운 시작에 함께해 주세요.'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={longDate + ' · ' + time + ' · ' + wedding.venue.name} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(og.src, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={wedding.isDemo ? '가상의 커플로 만든 샘플 청첩장' : title} />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="canonical" href={canonical.href} />
    <title>{title} | OUR SEASON</title>
    {kakaoJsKey && <script is:inline src="https://developers.kakao.com/sdk/js/kakao.js"></script>}
    <noscript><style>[data-reveal] { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#wedding-info">예식 안내 바로가기</a>
    <div class="invitation-shell">
      <header class="cover" id="top">
        <Image class="cover-image" src={wedding.hero.image} alt={wedding.hero.alt} style={{ objectPosition: wedding.hero.position }} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 44vw, 100vw" format="webp" loading="eager" fetchpriority="high" />
        <div class="cover-shade"></div>
        <div class="cover-top">
          <a href="#top" class="wordmark">OUR SEASON</a>
          <span class="cover-line"></span>
          <span class="eyebrow">A WEDDING INVITATION</span>
        </div>
        <p class="cover-aside">좋은 날,<br />우리라는 이야기가<br />시작됩니다.</p>
        <div class="cover-bottom">
          <p class="eyebrow cover-kicker">THE BEGINNING OF OUR FOREVER</p>
          <h1>The next<br /><em>chapter.</em></h1>
          <p class="couple-name">{wedding.groom.name}<span>&</span>{wedding.bride.name}</p>
          <p class="cover-date">{shortDate}. {weekday}<span>·</span>{time}</p>
          <a class="cover-venue" href="#wedding-info"><Icon name="pin" size={15} /><span>{venueLabel}</span></a>
          <a class="button cover-button" href="#story">초대장 열기 <Icon name="arrow" size={18} /></a>
        </div>
      </header>

      <main id="content" class="invitation-content">
        <nav class="section-nav" aria-label="청첩장 메뉴">
          <a href="#story" class="nav-home">OUR SEASON<span class="tiny-dot"></span></a>
          <div><a href="#moments">사진</a><a href="#wedding-info">예식 안내</a>{showContact && <button type="button" data-open-contact>연락하기</button>}</div>
        </nav>

        <section class="story-section section-pad" id="story" aria-labelledby="story-heading">
          <div class="section-label" data-reveal><span>OUR STORY</span><span>CHAPTER ONE</span></div>
          <div class="story-heading" data-reveal style="--reveal-delay:80ms"><h2 id="story-heading">우리라는 이야기</h2><p class="vertical-note" aria-hidden="true">LOVE<br />TRAVEL<br />AND US</p></div>
          <p class="section-subtitle" data-reveal style="--reveal-delay:140ms">함께한 순간들이 하나의 이야기가 되었습니다.</p>
          {featuredAlbum && <button type="button" class="album-feature photo-button" data-album={featuredAlbum.id} aria-label={featuredAlbum.title + ' 사진과 이야기 보기'} data-reveal style="--reveal-delay:200ms">
            <Image src={featuredAlbum.cover.image} alt={featuredAlbum.cover.alt} style={{ objectPosition: featuredAlbum.cover.position }} widths={[480, 800]} sizes="(min-width: 1000px) 50vw, 100vw" format="webp" loading="lazy" />
            <span class="album-gradient"></span>
            <span class="album-feature-label"><span class="eyebrow">ALBUM 01 · {featuredAlbum.photos.length} PHOTO{featuredAlbum.photos.length > 1 ? 'S' : ''}</span><span class="album-title">{featuredAlbum.title}</span></span>
            <span class="album-arrow"><Icon name="arrow" /></span>
          </button>}
          <div class="album-list">
            {albums.slice(1).map((album, index) => (
              <button type="button" class="album-row photo-button" data-album={album.id} aria-label={album.title + ' 사진과 이야기 보기'} data-reveal style={`--reveal-delay:${index * 100}ms`}>
                <Image src={album.cover.image} alt={album.cover.alt} style={{ objectPosition: album.cover.position }} widths={[240, 480]} sizes="(min-width: 1000px) 22vw, 42vw" format="webp" loading="lazy" />
                <span class="album-copy"><span class="eyebrow">ALBUM {String(index + 2).padStart(2, '0')}</span><span class="album-title">{album.title}</span><span class="album-link">사진 {album.photos.length}장 보기 <Icon name="arrow" size={17} /></span></span>
              </button>
            ))}
          </div>
          <div class="save-date" data-reveal>
            <p class="eyebrow ruled-label">SAVE THE DATE</p>
            <p class="display-date">{shortDate}</p>
            <p class="save-date-caption">우리의 새로운 시작</p>
            <p class="countdown" data-event-date={wedding.date} data-time-zone={wedding.timeZone} aria-live="off">소중한 당신을 초대합니다</p>
          </div>
          <div class="invitation-note" data-reveal>
            <span class="small-star" aria-hidden="true">✳</span>
            {wedding.introduction.map((line) => <p>{line}</p>)}
            <p class="signature">{wedding.groom.name} & {wedding.bride.name}</p>
          </div>
        </section>

        <section class="moments-section section-pad" id="moments" aria-labelledby="moments-heading">
          <div class="section-label" data-reveal><span>MOMENTS</span><span>OUR LITTLE ARCHIVE</span></div>
          <h2 class="english-heading" id="moments-heading" data-reveal style="--reveal-delay:80ms">Little things,<br /><em>us.</em></h2>
          <p class="section-subtitle" data-reveal style="--reveal-delay:140ms">작은 순간들이 모여, 특별한 우리가 됩니다.</p>
          <div class="highlights" aria-label="사진 앨범">
            {albums.map((album, index) => (
              <button type="button" data-album={album.id} class="highlight" aria-label={album.title + ' 앨범 열기'} data-reveal style={`--reveal-delay:${index * 80}ms`}>
                <span class="highlight-ring"><Image src={album.cover.image} alt="" width={144} height={144} fit="cover" format="webp" loading="lazy" /></span>
                <span>{album.label}</span>
              </button>
            ))}
          </div>
          <article class="feed-post" data-reveal>
            <header class="feed-header">
              <Image src={wedding.hero.image} alt="" width={64} height={64} fit="cover" format="webp" loading="lazy" />
              <span>{wedding.socialHandle}</span><span class="feed-header-note">OUR WEDDING</span>
            </header>
            <button type="button" class="feed-photo photo-button" data-gallery={feedPhoto.id} aria-label="웨딩 사진 크게 보기">
              <Image src={feedPhoto.image} alt={feedPhoto.alt} style={{ objectPosition: feedPhoto.position }} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 50vw, 100vw" format="webp" loading="lazy" />
              <span class="image-count">1 / {wedding.photos.length}</span>
            </button>
            <div class="feed-actions">
              <button type="button" class="icon-button like-button" aria-label="축하하는 마음 남기기" aria-pressed="false"><Icon name="heart" size={25} /></button>
              <button type="button" class="icon-button" data-share aria-label="청첩장 공유"><Icon name="share" size={23} /></button>
              <a class="icon-button bookmark-button" href={base + 'wedding.ics'} download="our-wedding.ics" aria-label="결혼식 일정 저장"><Icon name="bookmark" size={25} /></a>
            </div>
            <p class="feed-caption">평범한 날들이 모여,<br class="mobile-only" /> 우리의 가장 특별한 날.</p>
            <p class="feed-tags">#우리의계절 #새로운시작 #함께해요</p>
          </article>
          <div class="photo-strip">
            {previews.map((photo, index) => (
              <button type="button" class="photo-button" data-gallery={photo.id} aria-label={photo.title + ' 사진 크게 보기'} data-reveal style={`--reveal-delay:${index * 100}ms`}>
                <Image src={photo.image} alt={photo.alt} style={{ objectPosition: photo.position }} widths={[240, 480]} sizes="(min-width: 1000px) 25vw, 45vw" format="webp" loading="lazy" />
                <span>{photo.subtitle}</span>
              </button>
            ))}
          </div>
          <button type="button" class="button outline-button gallery-all-button" data-gallery={feedPhoto.id}>사진 전체 보기 · {gallery.length}장 <Icon name="arrow" size={17} /></button>
        </section>

        <section class="event-section section-pad" id="wedding-info" aria-labelledby="event-heading">
          <p class="eyebrow" data-reveal>THE DAY WE BECOME ONE</p>
          <h2 id="event-heading" data-reveal style="--reveal-delay:60ms">함께해 주세요</h2>
          <p class="event-date" data-reveal style="--reveal-delay:120ms">{longDate}<br />{time}</p>
          <p class="event-venue" data-reveal style="--reveal-delay:120ms">{venueLabel}</p>
          <div class="calendar" data-reveal style="--reveal-delay:180ms">
            <p class="calendar-month">{year}<span> / </span>{String(month).padStart(2, '0')}</p>
            <table aria-label={year + '년 ' + month + '월 결혼식 달력'}>
              <thead><tr>{['일', '월', '화', '수', '목', '금', '토'].map((d) => <th scope="col">{d}</th>)}</tr></thead>
              <tbody>{Array.from({ length: Math.ceil((firstWeekday + daysInMonth) / 7) }, (_, week) => (
                <tr>{Array.from({ length: 7 }, (_, col) => {
                  const date = week * 7 + col - emptyCells.length + 1;
                  return <td>{dates.includes(date) ? <span class:list={{ 'wedding-day': date === day }} aria-label={date === day ? date + '일 결혼식' : undefined}>{date}</span> : null}</td>;
                })}</tr>
              ))}</tbody>
            </table>
          </div>
          <a class="text-link calendar-link" href={base + 'wedding.ics'} download="our-wedding.ics"><Icon name="calendar" size={17} /> 캘린더에 저장</a>
          <div class="venue-card" data-reveal>
            <Icon name="pin" size={25} />
            <h3>{wedding.venue.name}</h3>
            <p>{wedding.venue.address || '예식장 상세 주소는 추후 안내드리겠습니다.'}</p>
            {wedding.venue.mapLinks.length > 0 && <div class="map-links">{wedding.venue.mapLinks.map((map) => <a class="button outline-button" href={map.url} target="_blank" rel="noopener noreferrer">{map.label}<Icon name="arrow" size={16} /></a>)}</div>}
            {wedding.venue.address && <button type="button" class="text-link" data-copy={wedding.venue.address} data-copy-message="주소를 복사했습니다."><Icon name="copy" size={16} /> 주소 복사</button>}
          </div>
          {wedding.venue.transport.map((item) => <div class="transport-note" data-reveal><h3>{item.title}</h3><p>{item.description}</p></div>)}
          {showContact && <button type="button" class="button contact-button" data-open-contact><Icon name="phone" size={17} /> 신랑 · 신부에게 연락하기</button>}
          {showAccounts && <details class="accounts">
            <summary>마음 전하실 곳 <Icon name="plus" size={18} /></summary>
            <div class="accounts-content">
              <p>축하해 주시는 따뜻한 마음, 소중히 간직하겠습니다.</p>
              {wedding.accounts.length ? wedding.accounts.map((account) => (
                <div class="account-row"><p><span>{account.side}측 · {account.name}</span><strong>{account.bank} {account.number}</strong></p><button type="button" class="text-link" data-copy={account.number} data-copy-message="계좌번호를 복사했습니다." aria-label={account.name + ' 계좌번호 복사'}><Icon name="copy" size={17} /> 복사</button></div>
              )) : <p class="pending-info">계좌 정보는 추후 안내드리겠습니다.</p>}
            </div>
          </details>}
          {kakaoJsKey && (
            <button
              type="button"
              class="button outline-button kakao-share-button"
              data-kakao-share
              data-kakao-js-key={kakaoJsKey}
              data-kakao-title={title}
              data-kakao-description={longDate + ' · ' + time + ' · ' + wedding.venue.name}
              data-kakao-image={new URL(og.src, Astro.site).href}
              data-kakao-url={canonical.href}
              data-kakao-map-url={kakaoMapUrl}
              hidden
            >
              <Icon name="share" size={17} /> 카카오톡으로 공유
            </button>
          )}
          <button type="button" class="button outline-button share-button" data-share><Icon name="share" size={17} /> 청첩장 공유하기</button>
        </section>

        <footer class="closing section-pad">
          <p class="eyebrow" data-reveal>SAME PEOPLE. A BRIGHTER TOMORROW.</p>
          <p class="closing-title" data-reveal style="--reveal-delay:80ms">To all our<br /><em>tomorrows.</em></p>
          <p class="closing-line" data-reveal style="--reveal-delay:160ms">{wedding.closing}</p>
          <p class="closing-names" data-reveal style="--reveal-delay:220ms">{wedding.groom.name} <span>&</span> {wedding.bride.name}</p>
          <a class="back-top text-link" href="#top">처음으로 <Icon name="arrow" size={16} /></a>
          {wedding.isDemo && <p class="demo-note">SAMPLE INVITATION<br />사진 속 인물과 이름·예식 정보는 가상의 예시입니다.</p>}
          <p class="footer-mark">OUR SEASON · {year}</p>
        </footer>
      </main>
    </div>
    <nav class="mobile-dock" aria-label="빠른 메뉴">
      <a href="#wedding-info"><Icon name="calendar" size={17} /> 예식 안내</a>
      {showContact ? <button type="button" data-open-contact><Icon name="phone" size={16} /> 연락하기</button> : <button type="button" data-share><Icon name="share" size={16} /> 공유하기</button>}
    </nav>

    <dialog class="gallery-dialog" id="gallery-dialog" aria-labelledby="gallery-title">
      <div class="gallery-header"><span class="eyebrow" id="gallery-label">사진 전체</span><button type="button" class="icon-button" data-close-gallery aria-label="사진 닫기"><Icon name="close" size={24} /></button></div>
      <div class="gallery-image-wrap"><img id="gallery-image" alt="" /><div class="gallery-load-state"><p id="gallery-load-status" role="status" aria-live="polite"></p><button type="button" class="text-link" data-gallery-retry hidden>사진 다시 불러오기</button></div><button type="button" class="gallery-control gallery-prev" data-gallery-prev aria-label="이전 사진"><Icon name="left" size={26} /></button><button type="button" class="gallery-control gallery-next" data-gallery-next aria-label="다음 사진"><Icon name="right" size={26} /></button></div>
      <div class="gallery-caption"><p class="eyebrow" id="gallery-counter"></p><h2 id="gallery-title"></h2><p id="gallery-story"></p></div>
    </dialog>
    {showContact && <dialog class="contact-dialog" id="contact-dialog" aria-labelledby="contact-title">
      <div class="contact-dialog-header"><span class="eyebrow">WITH LOVE</span><button type="button" class="icon-button" data-close-contact aria-label="연락처 닫기"><Icon name="close" /></button></div>
      <h2 id="contact-title">소중한 연락을 기다려요</h2>
      {contacts.map((person) => (
        <div class="person-contact"><p><span>{person.role}</span><strong>{person.fullName}</strong></p>{person.phone ? <div><a class="icon-button" href={'tel:' + person.phone} aria-label={person.fullName + '에게 전화'}><Icon name="phone" /></a><a class="text-link" href={'sms:' + person.phone}>문자</a></div> : <span class="pending-info">연락처 준비 중</span>}</div>
      ))}
    </dialog>}
    <dialog class="copy-dialog" id="copy-dialog" aria-labelledby="copy-title">
      <h2 id="copy-title">아래 내용을 복사해 주세요</h2><p>길게 누르거나 선택해 복사할 수 있어요.</p><input id="copy-value" aria-label="복사할 내용" readonly /><button type="button" class="button" data-close-copy>닫기</button>
    </dialog>
    <div class="toast" role="status" aria-live="polite" aria-atomic="true"></div>
    <div id="gallery-data" hidden data-photos={JSON.stringify(gallery)} data-albums={JSON.stringify(wedding.albums)}></div>
    <script src="../scripts/invitation.ts"></script>
  </body>
</html>
