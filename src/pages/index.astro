---
import { Image, getImage } from 'astro:assets';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/noto-serif-kr/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { wedding } from '../data/wedding';
import { loadGallery } from '../lib/gallery';
import { year, month, day, longDate, time, shortDate, weekday, firstWeekday, daysInMonth } from '../lib/event';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const title = wedding.groom.name + ' & ' + wedding.bride.name + ', 결혼합니다';
const canonical = new URL(base, Astro.site);
// Probe sizes through getImage attributes: reading properties of an imported image would publish the original file.
const heroSource = (await getImage({ src: wedding.hero.image })).attributes;
const heroWidth = Math.min(1200, Number(heroSource.width));
const heroHeight = Math.round(heroWidth * Number(heroSource.height) / Number(heroSource.width));
const heroWidths = [...new Set([480, 800, heroWidth].filter((w) => w <= heroWidth))];
const ogWidth = heroWidth;
const ogHeight = Math.round(ogWidth * 630 / 1200);
// hero.og is an optional landscape crop for link previews; otherwise sharp picks the focus.
const og = await getImage({ src: wedding.hero.og || wedding.hero.image, width: ogWidth, height: ogHeight, fit: 'cover', position: 'attention', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const venueLabel = [wedding.venue.name, wedding.venue.detail].filter(Boolean).join(' · ');
const summary = longDate + ' ' + time + ' · ' + wedding.venue.name;
const kakaoJsKey = (process.env.KAKAO_JS_KEY || '').trim();
// Kakao crops feed images to a square unless told the size, so the share card gets its own 3:4 portrait (hero.kakao when set).
// Always generated: an imported image that is never transformed would be published as the original.
const kakaoImage = await getImage({ src: wedding.hero.kakao || wedding.hero.image, width: 900, height: 1200, fit: 'cover', position: 'top', format: 'jpg' });
const kakaoImageUrl = new URL(kakaoImage.src, Astro.site).href;
const kakaoMapUrl = wedding.venue.mapLinks.find((map) => map.label.includes('카카오'))?.url || wedding.venue.mapLinks[0]?.url || canonical.href;
const contacts = [{ ...wedding.groom, role: '신랑' }, { ...wedding.bride, role: '신부' }].filter((person) => person.phone.trim());
const showContact = contacts.length > 0;
const accountGroups = (['신랑', '신부'] as const)
  .map((side) => ({ side, items: wedding.accounts.filter((account) => account.side === side) }))
  .filter((group) => group.items.length);
const showAccounts = wedding.isDemo || accountGroups.length > 0;
const families = [
  { ...wedding.groom, role: '신랑', child: '아들' },
  { ...wedding.bride, role: '신부', child: '딸' },
];
const showFamilies = families.some((person) => person.father.trim() || person.mother.trim());

// Photos come from src/assets/gallery; only generated URLs reach the page so the originals are never published.
const photos = loadGallery(wedding.gallery, {
  groom: wedding.groom.name,
  bride: wedding.bride.name,
  release: process.env.RELEASE_BUILD === '1',
});
const PREVIEW_COUNT = 9;
const collapsible = photos.length > 12;
// The lightbox image is always as wide as the screen.
const LIGHTBOX_SIZES = '100vw';
const prepared = await Promise.all(photos.map(async (photo) => {
  const source = (await getImage({ src: photo.image })).attributes;
  const sourceWidth = Number(source.width);
  const sourceHeight = Number(source.height);
  const width = Math.min(1600, sourceWidth);
  const full = await getImage({ src: photo.image, width, widths: width >= 1300 ? [1080, width] : [width], format: 'webp' });
  // Keep every thumbnail candidate 3:4 even when the source is small.
  const thumbWidth = Math.min(480, sourceWidth, Math.floor(sourceHeight * 3 / 4));
  return {
    thumb: { width: thumbWidth, height: Math.round(thumbWidth * 4 / 3), widths: [...new Set([240, 360, 480].filter((w) => w < thumbWidth).concat(thumbWidth))] },
    data: {
      id: photo.id,
      src: full.src,
      srcset: full.srcSet.attribute,
      w: Number(full.attributes.width),
      h: Number(full.attributes.height),
      alt: photo.alt,
      caption: photo.caption,
    },
  };
}));
const gallery = prepared.map((item) => item.data);
const emptyCells = Array.from({ length: firstWeekday });
const dates = Array.from({ length: daysInMonth }, (_, i) => i + 1);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#181b18" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={summary + '. 저희의 새로운 시작에 함께해 주세요.'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={wedding.hero.alt} />
    <link rel="icon" type="image/png" sizes="32x32" href={base + 'favicon-32.png'} />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'} />
    <link rel="canonical" href={canonical.href} />
    <title>{title} | OUR SEASON</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    {kakaoJsKey && <script is:inline src="https://developers.kakao.com/sdk/js/kakao.js"></script>}
    <noscript><style>[data-reveal] { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#invitation">본문 바로가기</a>
    <div class="invitation-shell">
      <header class="cover" id="top">
        <Image class="cover-image" src={wedding.hero.image} alt={wedding.hero.alt} style={{ objectPosition: wedding.hero.position }} width={heroWidth} height={heroHeight} widths={heroWidths} sizes="(min-width: 1000px) 44vw, 100vw" format="webp" loading="eager" fetchpriority="high" />
        <div class="cover-shade"></div>
        <div class="cover-top">
          <a href="#top" class="wordmark">OUR SEASON</a>
          <span class="cover-line"></span>
          <span class="eyebrow" lang="en">A WEDDING INVITATION</span>
        </div>
        <p class="cover-aside">좋은 날,<br />우리라는 이야기가<br />시작됩니다.</p>
        <div class="cover-bottom">
          <p class="eyebrow cover-kicker" lang="en">THE BEGINNING OF OUR FOREVER</p>
          <h1 lang="en">The next<br /><em>chapter.</em></h1>
          <p class="couple-name">{wedding.groom.name}<span>&</span>{wedding.bride.name}</p>
          <p class="cover-date">{shortDate}. {weekday}<span class="sep" aria-hidden="true">·</span><span class="ko">{time}</span></p>
          <a class="cover-venue" href="#location"><Icon name="pin" size={15} /><span>{venueLabel}</span></a>
          <a class="button cover-button" href="#invitation">초대장 열기 <Icon name="arrow" size={18} /></a>
        </div>
      </header>

      <main id="content" class="invitation-content">
        <nav class="section-nav" aria-label="청첩장 메뉴">
          <a href="#invitation" class="nav-home">OUR SEASON<span class="tiny-dot"></span></a>
          <div>
            <a href="#gallery">사진</a>
            <a href="#location">오시는 길</a>
            {showAccounts && <a href="#accounts">마음 전하실 곳</a>}
            {showContact && <button type="button" data-open-contact>연락하기</button>}
          </div>
        </nav>

        <section class="paper-section intro-section section-pad" id="invitation" aria-labelledby="invitation-heading">
          <h2 class="visually-hidden" id="invitation-heading">결혼식에 초대합니다</h2>
          <div class="save-date" data-reveal>
            <p class="eyebrow ruled-label" lang="en">SAVE THE DATE</p>
            <p class="display-date">{shortDate}</p>
            <p class="save-date-when">{longDate} {time}</p>
            <p class="save-date-venue">{wedding.venue.name}</p>
          </div>
          <div class="calendar" data-reveal>
            <p class="calendar-month">{year}<span> / </span>{String(month).padStart(2, '0')}</p>
            <table aria-label={year + '년 ' + month + '월 결혼식 달력'}>
              <thead><tr>{['일', '월', '화', '수', '목', '금', '토'].map((d) => <th scope="col">{d}</th>)}</tr></thead>
              <tbody>{Array.from({ length: Math.ceil((firstWeekday + daysInMonth) / 7) }, (_, week) => (
                <tr>{Array.from({ length: 7 }, (_, col) => {
                  const date = week * 7 + col - emptyCells.length + 1;
                  return <td>{dates.includes(date) ? (date === day ? <span class="wedding-day">{date}<span class="visually-hidden">일 결혼식</span></span> : <span>{date}</span>) : null}</td>;
                })}</tr>
              ))}</tbody>
            </table>
          </div>
          <p class="countdown" data-event-date={wedding.date} data-time-zone={wedding.timeZone} aria-live="off">소중한 당신을 초대합니다</p>
          <a class="text-link calendar-link" href={base + 'wedding.ics'} download="our-wedding.ics"><Icon name="calendar" size={17} /> 캘린더에 저장</a>

          <div class="invitation-note" data-reveal>
            <span class="small-star" aria-hidden="true">✳</span>
            {wedding.introduction.map((line) => <p>{line}</p>)}
            {showFamilies ? (
              <div class="families">
                {families.map((person) => (
                  person.father.trim() || person.mother.trim()
                    ? <p><span class="parents">{[person.father, person.mother].map((name) => name.trim()).filter(Boolean).join(' · ')}</span><span class="relation">의 {person.relation.trim() || person.child}</span>{' '}<strong>{person.name}</strong></p>
                    : <p><span class="relation">{person.role}</span>{' '}<strong>{person.fullName}</strong></p>
                ))}
              </div>
            ) : <p class="signature">{wedding.groom.name} & {wedding.bride.name}</p>}
          </div>
        </section>

        <section class="paper-section gallery-section section-pad" id="gallery" aria-labelledby="gallery-heading">
          <header class="section-head" data-reveal>
            <p class="eyebrow" lang="en">GALLERY</p>
            <h2 id="gallery-heading">우리의 순간</h2>
            <p class="section-lead">사진을 누르면 크게 볼 수 있어요.</p>
          </header>
          <ul class:list={['gallery-grid', { 'is-collapsible': collapsible }]} id="gallery-grid" data-reveal>
            {photos.map((photo, index) => (
              <li class:list={{ 'is-extra': collapsible && index >= PREVIEW_COUNT }}>
                <a class="gallery-thumb" href={gallery[index].src} data-gallery={photo.id}>
                  <Image src={photo.image} alt={photo.alt} width={prepared[index].thumb.width} height={prepared[index].thumb.height} widths={prepared[index].thumb.widths} sizes="(min-width: 600px) 200px, 31vw" fit="cover" position={photo.position} format="webp" loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
          {collapsible && <button type="button" class="button outline-button gallery-more" data-gallery-more aria-controls="gallery-grid" aria-expanded="false" hidden>사진 더보기 <span>+{photos.length - PREVIEW_COUNT}</span></button>}
        </section>

        <section class="paper-section location-section section-pad" id="location" aria-labelledby="location-heading">
          <header class="section-head" data-reveal>
            <p class="eyebrow" lang="en">LOCATION</p>
            <h2 id="location-heading">오시는 길</h2>
          </header>
          <div class="venue" data-reveal>
            <h3>{wedding.venue.name}</h3>
            <p class="venue-address">{wedding.venue.address || '예식장 상세 주소는 추후 안내드리겠습니다.'}</p>
            {wedding.venue.address && <button type="button" class="text-link" data-copy={wedding.venue.address} data-copy-message="주소를 복사했습니다."><Icon name="copy" size={16} /> 주소 복사</button>}
            {wedding.venue.mapLinks.length > 0 && <div class="map-links">{wedding.venue.mapLinks.map((map) => <a class="button outline-button" href={map.url} target="_blank" rel="noopener noreferrer">{map.label}<Icon name="arrow" size={16} /></a>)}</div>}
          </div>
          {wedding.venue.transport.length > 0 && (
            <dl class="transport" data-reveal>
              {wedding.venue.transport.map((item) => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}
            </dl>
          )}
          {showContact && <button type="button" class="button contact-button" data-open-contact><Icon name="phone" size={17} /> 신랑 · 신부에게 연락하기</button>}
        </section>

        {showAccounts && (
          <section class="paper-section accounts-section section-pad" id="accounts" aria-labelledby="accounts-heading">
            <header class="section-head" data-reveal>
              <p class="eyebrow" lang="en">WITH GRATITUDE</p>
              <h2 id="accounts-heading">마음 전하실 곳</h2>
              {accountGroups.length > 0 && <p class="section-lead">참석이 어려우신 분들을 위해 계좌번호를 안내드립니다. 축하해 주시는 따뜻한 마음, 소중히 간직하겠습니다.</p>}
            </header>
            <div class="account-groups" data-reveal>
              {accountGroups.length ? accountGroups.map((group) => (
                <details class="accounts">
                  <summary>{group.side}측 계좌번호 <Icon name="plus" size={18} /></summary>
                  <ul class="account-list">
                    {group.items.map((account) => (
                      <li class="account-row">
                        <p><span class="account-owner">{account.relation?.trim() || group.side} {account.name}</span><span class="account-number">{account.bank} {account.number}</span></p>
                        <button type="button" class="copy-chip" data-copy={account.number} data-copy-message="계좌번호를 복사했습니다." aria-label={account.name + ' 계좌번호 복사'}><Icon name="copy" size={15} /> 복사</button>
                      </li>
                    ))}
                  </ul>
                </details>
              )) : <p class="pending-info">계좌 정보는 추후 안내드리겠습니다.</p>}
            </div>
          </section>
        )}

        <div class="paper-section share-section section-pad">
          <div class="share-actions">
            {kakaoJsKey && (
              <button
                type="button"
                class="button kakao-share-button"
                data-kakao-share
                data-kakao-js-key={kakaoJsKey}
                data-kakao-title={title}
                data-kakao-description={summary}
                data-kakao-image={kakaoImageUrl}
                data-kakao-image-width={String(kakaoImage.attributes.width)}
                data-kakao-image-height={String(kakaoImage.attributes.height)}
                data-kakao-url={canonical.href}
                data-kakao-map-url={kakaoMapUrl}
                hidden
              >
                <Icon name="share" size={17} /> 카카오톡으로 공유
              </button>
            )}
            <button type="button" class="button outline-button share-button" data-share><Icon name="share" size={17} /> 청첩장 공유하기</button>
          </div>
        </div>

        <footer class="closing section-pad">
          <p class="closing-title" lang="en" data-reveal>To all our<br /><em>tomorrows.</em></p>
          <p class="closing-line" data-reveal style="--reveal-delay:80ms">{wedding.closing}</p>
          <p class="closing-names" data-reveal style="--reveal-delay:140ms">{wedding.groom.name} <span>&</span> {wedding.bride.name}</p>
          <a class="back-top text-link" href="#top">처음으로 <Icon name="arrow" size={16} /></a>
          {wedding.isDemo && <p class="demo-note">SAMPLE PREVIEW<br />사진과 일부 정보는 준비 중인 예시입니다.</p>}
          <p class="footer-mark">OUR SEASON · {year}</p>
        </footer>
      </main>
    </div>
    <nav class="mobile-dock" aria-label="빠른 메뉴">
      <a href="#location"><Icon name="pin" size={17} /> 오시는 길</a>
      {showContact ? <button type="button" data-open-contact><Icon name="phone" size={16} /> 연락하기</button> : <button type="button" data-share><Icon name="share" size={16} /> 공유하기</button>}
    </nav>

    <dialog class="gallery-dialog" id="gallery-dialog" aria-label="사진 크게 보기">
      <div class="gallery-header">
        <p class="gallery-counter" id="gallery-counter" aria-live="polite"></p>
        <button type="button" class="icon-button" data-close-gallery aria-label="사진 닫기"><Icon name="close" size={24} /></button>
      </div>
      <div class="gallery-image-wrap">
        <img id="gallery-image" alt="" sizes={LIGHTBOX_SIZES} />
        <div class="gallery-load-state"><p id="gallery-load-status" role="status" aria-live="polite"></p><button type="button" class="text-link" data-gallery-retry hidden>사진 다시 불러오기</button></div>
        <button type="button" class="gallery-control gallery-prev" data-gallery-prev aria-label="이전 사진"><Icon name="left" size={24} /></button>
        <button type="button" class="gallery-control gallery-next" data-gallery-next aria-label="다음 사진"><Icon name="right" size={24} /></button>
      </div>
      <p class="gallery-caption" id="gallery-caption" hidden></p>
    </dialog>
    {showContact && <dialog class="contact-dialog" id="contact-dialog" aria-labelledby="contact-title">
      <div class="contact-dialog-header"><span class="eyebrow">WITH LOVE</span><button type="button" class="icon-button" data-close-contact aria-label="연락처 닫기"><Icon name="close" /></button></div>
      <h2 id="contact-title">소중한 연락을 기다려요</h2>
      {contacts.map((person) => (
        <div class="person-contact"><p><span>{person.role}</span><strong>{person.fullName}</strong></p><div><a class="icon-button" href={'tel:' + person.phone} aria-label={person.fullName + '에게 전화'}><Icon name="phone" /></a><a class="text-link" href={'sms:' + person.phone}>문자</a></div></div>
      ))}
    </dialog>}
    <dialog class="copy-dialog" id="copy-dialog" aria-labelledby="copy-title">
      <h2 id="copy-title">아래 내용을 복사해 주세요</h2><p>길게 누르거나 선택해 복사할 수 있어요.</p><input id="copy-value" aria-label="복사할 내용" readonly /><button type="button" class="button" data-close-copy>닫기</button>
    </dialog>
    <div class="toast" role="status" aria-live="polite" aria-atomic="true"></div>
    <div id="gallery-data" hidden data-photos={JSON.stringify(gallery)} data-sizes={LIGHTBOX_SIZES}></div>
    <script src="../scripts/invitation.ts"></script>
  </body>
</html>
